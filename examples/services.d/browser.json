{
  "enabled": true,
  "venom_id": "browser-main",
  "package_id": "browser",
  "kind": "browser",
  "version": "1",
  "state": "online",
  "categories": ["browser", "automation", "macos"],
  "host_roles": ["node"],
  "binding_scopes": ["workspace"],
  "runtime_kind": "native",
  "requirements": {
    "host_capabilities": ["managed_browser"]
  },
  "endpoints": [
    "/nodes/{node_id}/venoms/browser-main"
  ],
  "mounts": [
    {
      "mount_id": "browser-main",
      "mount_path": "/nodes/{node_id}/venoms/browser-main",
      "state": "online"
    }
  ],
  "capabilities": {
    "invoke": true,
    "discoverable": true,
    "observe": true,
    "act": true,
    "operations": ["observe", "act"],
    "device": "browser"
  },
  "ops": {
    "model": "namespace",
    "invoke": "control/invoke.json",
    "paths": {
      "invoke": "control/invoke.json"
    }
  },
  "runtime": {
    "type": "native_proc",
    "abi": "namespace-driver-v1",
    "executable_path": "./spiderweb-browser-driver",
    "timeout_ms": 60000
  },
  "permissions": {
    "default": "deny-by-default",
    "allow_roles": ["admin", "user"],
    "scope": "workspace",
    "requires_user_consent": true,
    "platform": "macos"
  },
  "schema": {
    "model": "browser-observe-act-v1",
    "control": {
      "invoke": "control/invoke.json"
    },
    "result": "result.json",
    "status": "status.json",
    "health": "health.json",
    "artifacts": {
      "observation": "artifacts/last_observation.json",
      "screenshot": "artifacts/last_screenshot.png",
      "dom": "artifacts/last_dom.json"
    }
  },
  "invoke_template": {
    "op": "observe",
    "arguments": {
      "include_dom": true,
      "include_screenshot": true
    }
  },
  "help_md": "macOS browser automation driver. Write JSON payloads to control/invoke.json with op observe or act."
}
